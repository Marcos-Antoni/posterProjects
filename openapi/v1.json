{
  "openapi": "3.0.3",
  "info": {
    "title": "posterProjects Mobile API",
    "version": "1.0.0",
    "description": "Stateless bearer-token surface at /api/v1, consumed by the posterMobile Flutter client. Tokens are Laravel Sanctum personal access tokens named `mobile` with the `mobile` ability, separate from the web session app and the `/mcp` bearer surface (which uses the `mcp` ability). This document describes the surface as implemented, including the exact JSON error contract."
  },
  "servers": [
    {
      "url": "/",
      "description": "Relative to the application origin. Paths below already include the full /api/v1 prefix."
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Credentials-to-token exchange, identity, and revocation for the mobile bearer surface."
    },
    {
      "name": "Projects",
      "description": "Read-only project list and detail for the posterMobile client. Writes are a separate change."
    },
    {
      "name": "Issues",
      "description": "Read-only, board-ordered issue list and single-issue detail, nested under a project and addressed by the human key. Writes are a separate change, gated on board-column/sprint discovery."
    }
  ],
  "paths": {
    "/api/v1/login": {
      "post": {
        "operationId": "loginMobile",
        "tags": ["Auth"],
        "summary": "Exchange credentials for a mobile bearer token",
        "description": "Validates the owner's email and password without starting a web session (Auth::validate(), never Auth::attempt()). On success, revokes every prior token named `mobile` before minting a new one named `mobile` with exactly the `mobile` ability. A pre-existing `mcp` token is never touched. Throttled by the named limiter `api-login`: 5 attempts per minute keyed by `email|ip`, and 10 attempts per minute keyed by `ip` alone; both successful and failed attempts count toward each limit.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credentials valid. Returns the plain-text token; it is never shown again.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" },
                "example": { "token": "1|abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMN" }
              }
            }
          },
          "422": {
            "description": "Missing/invalid fields, or a recognized-but-wrong email/password pair. Bad credentials are reported under the `email` field, reusing the existing Spanish copy.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" },
                "examples": {
                  "bad_credentials": {
                    "summary": "Wrong password (or unknown email)",
                    "value": {
                      "message": "Estas credenciales no coinciden con nuestros registros.",
                      "errors": { "email": ["Estas credenciales no coinciden con nuestros registros."] }
                    }
                  },
                  "missing_fields": {
                    "summary": "Missing email and password",
                    "value": {
                      "message": "El correo electrónico es obligatorio.",
                      "errors": {
                        "email": ["El correo electrónico es obligatorio."],
                        "password": ["La contraseña es obligatoria."]
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "6th attempt within the one-minute window for the same email+IP, or 11th for the same IP.",
            "headers": {
              "Retry-After": {
                "description": "Seconds until the limiter resets.",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ThrottledResponse" },
                "example": { "message": "Demasiados intentos de acceso. Por favor, inténtalo de nuevo en 42 segundos." }
              }
            }
          }
        }
      }
    },
    "/api/v1/user": {
      "get": {
        "operationId": "getAuthenticatedMobileUser",
        "tags": ["Auth"],
        "summary": "Return the authenticated owner",
        "description": "Requires a bearer token carrying the `mobile` ability (or the legacy wildcard `['*']` ability). Exposes exactly id, name, and email — no other user attribute.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The owner's identity.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" },
                "example": { "data": { "id": 1, "name": "Marco", "email": "marco@example.com" } }
              }
            }
          },
          "401": {
            "description": "No token, or a token that does not authenticate.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge.",
                "schema": { "type": "string", "example": "Bearer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthenticatedResponse" },
                "example": { "message": "No autenticado." }
              }
            }
          },
          "403": {
            "description": "A valid token that lacks the `mobile` ability (e.g. an `mcp`-only token).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForbiddenResponse" },
                "example": { "message": "Este token no tiene permiso para usar esta API." }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "listProjects",
        "tags": ["Projects"],
        "summary": "List the authenticated owner's active projects",
        "description": "Returns the requesting user's active (non-archived) projects, scoped by membership, ordered by name then id. Requires the `mobile` ability. There is no pagination envelope today: `data` is always the complete result set. Forward-compatibility rule for the client: if a future response omits `meta`, `data` is still the complete set — there is no next page. If `meta` is present, the last page is reached when `meta.current_page === meta.last_page` (equivalently `links.next === null`). A client written against this rule never breaks and never has to assume the response has exactly one key.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "The member's active projects, ordered by name.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectCollectionResponse" },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "key": "DEMO",
                      "name": "Demo",
                      "description": "Sample project",
                      "issues_count": 3,
                      "updated_at": "2026-07-21T07:48:51+00:00",
                      "archived": false
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that does not authenticate.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge.",
                "schema": { "type": "string", "example": "Bearer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthenticatedResponse" },
                "example": { "message": "No autenticado." }
              }
            }
          },
          "403": {
            "description": "A valid token that lacks the `mobile` ability (e.g. an `mcp`-only token).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForbiddenResponse" },
                "example": { "message": "Este token no tiene permiso para usar esta API." }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}": {
      "get": {
        "operationId": "getProject",
        "tags": ["Projects"],
        "summary": "Resolve a single project by key, active or archived",
        "description": "Resolves `{project}` against the project's `key` column for any project the requesting user is a member of, including a soft-deleted (archived) one — a stale link to an archived project still resolves so the client can render a meaningful state instead of a dead end. Requires the `mobile` ability. Unknown key, non-member key, and force-deleted key are indistinguishable: all three respond `404` with the identical generic body, never `403` — the response never discloses whether an inaccessible key exists.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "The project's `key` (e.g. DEMO) — never the numeric `id`.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The project, active or archived.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectResponse" },
                "example": {
                  "data": {
                    "id": 1,
                    "key": "DEMO",
                    "name": "Demo",
                    "description": "Sample project",
                    "issues_count": 3,
                    "updated_at": "2026-07-21T07:48:51+00:00",
                    "archived": false
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that does not authenticate.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge.",
                "schema": { "type": "string", "example": "Bearer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthenticatedResponse" },
                "example": { "message": "No autenticado." }
              }
            }
          },
          "403": {
            "description": "A valid token that lacks the `mobile` ability (e.g. an `mcp`-only token).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForbiddenResponse" },
                "example": { "message": "Este token no tiene permiso para usar esta API." }
              }
            }
          },
          "404": {
            "description": "No project with this key is resolvable for the requesting user: the key never existed, belongs to a project the user is not a member of, or was permanently force-deleted. These three causes are intentionally indistinguishable.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotFoundResponse" },
                "example": { "message": "Recurso no encontrado." }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}/issues": {
      "get": {
        "operationId": "listProjectIssues",
        "tags": ["Issues"],
        "summary": "List a project's issues, board-ordered and paginated",
        "description": "Returns `{project}`'s issues ordered by board column position, then issue position, then issue id as a mandatory tiebreaker (position is unique only within a board-column/sprint scope). Paginated: `per_page` defaults to 50 and is capped at 100 regardless of the requested value; `links.next` retains every applied query filter. `?sprint=` accepts an integer sprint id belonging to `{project}`, or the literal `backlog` for unsprinted issues; absent, every issue in the project is returned. A sprint id belonging to a different project responds `404`; a value that is neither `backlog` nor an integer responds `422`. Requires the `mobile` ability. An archived (soft-deleted) `{project}` responds `404`, unlike `GET /api/v1/projects/{project}`.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "The project's `key` (e.g. DEMO) — never the numeric `id`.",
            "schema": { "type": "string" }
          },
          {
            "name": "sprint",
            "in": "query",
            "required": false,
            "description": "An integer sprint id belonging to `{project}`, or the literal `backlog` for unsprinted issues. Absent returns every issue in the project.",
            "schema": { "type": "string" }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Items per page. Default 50, capped at 100.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1-indexed.",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "The project's issues, board-ordered, one page at a time.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IssueCollectionResponse" },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "key": "DEMO-1",
                      "number": 1,
                      "title": "Set up CI",
                      "type": "task",
                      "priority": 3,
                      "story_points": 3,
                      "due_date": "2026-08-15",
                      "board_column_id": 1,
                      "sprint_id": null,
                      "parent_id": null,
                      "position": 0,
                      "assignee": { "id": 2, "name": "Ada Lovelace" },
                      "labels": [{ "id": 1, "name": "backend" }],
                      "updated_at": "2026-07-21T07:48:51+00:00"
                    }
                  ],
                  "links": { "first": "/api/v1/projects/DEMO/issues?page=1", "last": "/api/v1/projects/DEMO/issues?page=1", "prev": null, "next": null },
                  "meta": {
                    "current_page": 1,
                    "last_page": 1,
                    "per_page": 50,
                    "total": 1,
                    "from": 1,
                    "to": 1,
                    "path": "/api/v1/projects/DEMO/issues",
                    "links": [{ "url": null, "label": "&laquo; Previous", "page": null, "active": false }]
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that does not authenticate.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge.",
                "schema": { "type": "string", "example": "Bearer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthenticatedResponse" },
                "example": { "message": "No autenticado." }
              }
            }
          },
          "403": {
            "description": "A valid token that lacks the `mobile` ability (e.g. an `mcp`-only token).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForbiddenResponse" },
                "example": { "message": "Este token no tiene permiso para usar esta API." }
              }
            }
          },
          "404": {
            "description": "`{project}` is unresolvable for the requesting user (unknown key, non-member key, or archived project), or `?sprint=` names a sprint belonging to a different project. Every cause is byte-identical and never discloses which one occurred.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotFoundResponse" },
                "example": { "message": "Recurso no encontrado." }
              }
            }
          },
          "422": {
            "description": "`per_page` above 100, `page` not a positive integer, or `sprint` neither `backlog` nor an integer.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" },
                "example": { "message": "El campo sprint seleccionado no es válido.", "errors": { "sprint": ["El campo sprint seleccionado no es válido."] } }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project}/issues/{issue}": {
      "get": {
        "operationId": "getProjectIssue",
        "tags": ["Issues"],
        "summary": "Resolve a single issue by its human key",
        "description": "Resolves `{issue}` (e.g. DEMO-123) via `Issue::resolveByKey()` against `{project}`, never route-model binding — `key` is a computed accessor, not a column. Requires the `mobile` ability. Seven distinct causes converge on the identical `404`: an unresolvable `{project}` (unknown key, non-member key, archived project), and a malformed, cross-project, or unknown `{issue}` (no dash, non-numeric/empty suffix, prefix mismatch, unknown number). None is distinguishable from the response.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "description": "The project's `key` (e.g. DEMO) — never the numeric `id`.",
            "schema": { "type": "string" }
          },
          {
            "name": "issue",
            "in": "path",
            "required": true,
            "description": "The full issue key (e.g. DEMO-123) — never the numeric `id`.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The issue, with every relation embedded.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IssueResponse" },
                "example": {
                  "data": {
                    "id": 1,
                    "key": "DEMO-1",
                    "number": 1,
                    "title": "Set up CI",
                    "type": "task",
                    "priority": 3,
                    "story_points": 3,
                    "due_date": "2026-08-15",
                    "board_column_id": 1,
                    "sprint_id": null,
                    "parent_id": null,
                    "position": 0,
                    "assignee": { "id": 2, "name": "Ada Lovelace" },
                    "labels": [{ "id": 1, "name": "backend" }],
                    "updated_at": "2026-07-21T07:48:51+00:00",
                    "description": "Configure the CI pipeline.",
                    "reporter": { "id": 3, "name": "Alan Turing" },
                    "parent": null,
                    "children": [{ "id": 5, "key": "DEMO-5", "title": "Add the lint step", "type": "task", "board_column_id": 1 }],
                    "comments": [{ "id": 9, "body": "Started this.", "created_at": "2026-07-21T07:50:00+00:00", "author": { "id": 3, "name": "Alan Turing" } }]
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that does not authenticate.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge.",
                "schema": { "type": "string", "example": "Bearer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthenticatedResponse" },
                "example": { "message": "No autenticado." }
              }
            }
          },
          "403": {
            "description": "A valid token that lacks the `mobile` ability (e.g. an `mcp`-only token).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForbiddenResponse" },
                "example": { "message": "Este token no tiene permiso para usar esta API." }
              }
            }
          },
          "404": {
            "description": "`{project}` is unresolvable for the requesting user (unknown key, non-member key, or archived project), or `{issue}` is malformed, belongs to a different project, or has no matching number in this project. All seven causes are byte-identical and never disclose which one occurred.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotFoundResponse" },
                "example": { "message": "Recurso no encontrado." }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "operationId": "logoutMobile",
        "tags": ["Auth"],
        "summary": "Revoke the presenting token",
        "description": "Revokes only the token used to authenticate the request, via currentAccessToken(). Every other token (of either name) is left untouched. Requires the `mobile` ability.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": {
            "description": "Token revoked. No body."
          },
          "401": {
            "description": "No token, or a token that does not authenticate.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge.",
                "schema": { "type": "string", "example": "Bearer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnauthenticatedResponse" },
                "example": { "message": "No autenticado." }
              }
            }
          },
          "403": {
            "description": "A valid token that lacks the `mobile` ability.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForbiddenResponse" },
                "example": { "message": "Este token no tiene permiso para usar esta API." }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum personal access token",
        "description": "Plain-text Sanctum token minted by POST /api/v1/login, sent as `Authorization: Bearer <token>`. Carries the `mobile` ability (or the legacy wildcard `['*']`)."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": {
            "type": "string",
            "description": "Plain-text Sanctum token. Shown once; not recoverable afterward."
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "email"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/User" }
        }
      },
      "Project": {
        "type": "object",
        "required": ["id", "key", "name", "description", "issues_count", "updated_at", "archived"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "Stable local primary key. Never used to address the resource." },
          "key": { "type": "string", "description": "The addressable identifier, e.g. DEMO." },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "issues_count": { "type": "integer", "description": "Eager-loaded aggregate; never triggers a query per project." },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "archived": { "type": "boolean", "description": "True only when the project is soft-deleted." }
        }
      },
      "ProjectResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Project" }
        }
      },
      "ProjectCollectionResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Project" }
          }
        }
      },
      "UserRef": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "LabelRef": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "Issue": {
        "type": "object",
        "description": "The board-card shape: exactly these 15 fields, no more, no fewer.",
        "required": ["id", "key", "number", "title", "type", "priority", "story_points", "due_date", "board_column_id", "sprint_id", "parent_id", "position", "assignee", "labels", "updated_at"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "Stable local primary key. Never used to address the resource." },
          "key": { "type": "string", "description": "The addressable identifier, e.g. DEMO-123." },
          "number": { "type": "integer", "description": "The per-project sequential number, i.e. the suffix of key." },
          "title": { "type": "string" },
          "type": { "type": "string", "enum": ["epic", "story", "task", "bug"] },
          "priority": { "type": "integer", "enum": [1, 2, 3, 4, 5], "description": "1 = Highest ... 5 = Lowest." },
          "story_points": { "type": "integer", "nullable": true },
          "due_date": { "type": "string", "format": "date", "nullable": true },
          "board_column_id": { "type": "integer", "format": "int64" },
          "sprint_id": { "type": "integer", "format": "int64", "nullable": true },
          "parent_id": { "type": "integer", "format": "int64", "nullable": true },
          "position": { "type": "integer", "description": "Order within its board column and sprint scope. Not globally unique." },
          "assignee": { "$ref": "#/components/schemas/UserRef", "nullable": true },
          "labels": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LabelRef" }
          },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "required": ["first", "last", "prev", "next"],
        "properties": {
          "first": { "type": "string", "nullable": true },
          "last": { "type": "string", "nullable": true },
          "prev": { "type": "string", "nullable": true },
          "next": { "type": "string", "nullable": true, "description": "Retains every applied query filter (e.g. ?sprint=). Null on the last page." }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": ["current_page", "last_page", "per_page", "total", "from", "to", "path"],
        "properties": {
          "current_page": { "type": "integer" },
          "last_page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer" },
          "from": { "type": "integer", "nullable": true },
          "to": { "type": "integer", "nullable": true },
          "path": { "type": "string" },
          "links": {
            "type": "array",
            "description": "Laravel's default presentational page-link list. Ignorable by the client.",
            "items": {
              "type": "object",
              "properties": {
                "url": { "type": "string", "nullable": true },
                "label": { "type": "string" },
                "page": { "type": "integer", "nullable": true },
                "active": { "type": "boolean" }
              }
            }
          }
        }
      },
      "IssueCollectionResponse": {
        "type": "object",
        "required": ["data", "links", "meta"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Issue" }
          },
          "links": { "$ref": "#/components/schemas/PaginationLinks" },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        }
      },
      "IssueRef": {
        "type": "object",
        "description": "A parent issue reference.",
        "required": ["id", "key", "title"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "key": { "type": "string" },
          "title": { "type": "string" }
        }
      },
      "IssueChildRef": {
        "type": "object",
        "description": "A child issue reference, as it appears on the parent's board-card list.",
        "required": ["id", "key", "title", "type", "board_column_id"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "key": { "type": "string" },
          "title": { "type": "string" },
          "type": { "type": "string", "enum": ["epic", "story", "task", "bug"] },
          "board_column_id": { "type": "integer", "format": "int64" }
        }
      },
      "IssueComment": {
        "type": "object",
        "required": ["id", "body", "created_at", "author"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "body": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time", "nullable": true },
          "author": { "$ref": "#/components/schemas/UserRef" }
        }
      },
      "IssueDetail": {
        "description": "The full single-issue shape: the 15 `Issue` fields plus description, reporter, parent, children, and comments.",
        "allOf": [
          { "$ref": "#/components/schemas/Issue" },
          {
            "type": "object",
            "required": ["description", "reporter", "parent", "children", "comments"],
            "properties": {
              "description": { "type": "string", "nullable": true },
              "reporter": { "$ref": "#/components/schemas/UserRef" },
              "parent": { "$ref": "#/components/schemas/IssueRef", "nullable": true },
              "children": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/IssueChildRef" }
              },
              "comments": {
                "type": "array",
                "description": "Ordered by created_at ascending, with issue id as the tiebreaker for comments sharing a timestamp.",
                "items": { "$ref": "#/components/schemas/IssueComment" }
              }
            }
          }
        ]
      },
      "IssueResponse": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/IssueDetail" }
        }
      },
      "NotFoundResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "example": "Recurso no encontrado." }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "required": ["message", "errors"],
        "properties": {
          "message": { "type": "string", "description": "The first validation error message." },
          "errors": {
            "type": "object",
            "description": "Field name to array of error messages.",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "UnauthenticatedResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "example": "No autenticado." }
        }
      },
      "ForbiddenResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "example": "Este token no tiene permiso para usar esta API." }
        }
      },
      "ThrottledResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string", "description": "Spanish throttle message including the retry delay in seconds." }
        }
      }
    }
  }
}
